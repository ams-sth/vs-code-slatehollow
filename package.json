{
    "name": "slatehollow",
    "displayName": "Slatehollow",
    "description": "Clean surfaces, five syntax colours. Enough to tell your code apart, not enough to distract. Ships with a light variant — Slatehollow Light — and an OLED-tuned dark variant.",
    "version": "1.1.0",
    "publisher": "ams-sth",
    "author": "Amsh Shrestha <amshstha37@gmail.com>",
    "icon": "slatehollow.png",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Themes"
    ],
    "keywords": [
        "theme",
        "dark",
        "minimal",
        "slatehollow",
        "light",
        "oled",
        "jetbrains",
        "typescript",
        "developer",
        "editor",
        "coding"
    ],
    "contributes": {
        "themes": [
            {
                "label": "Slatehollow Dark",
                "uiTheme": "vs-dark",
                "path": "themes/slatehollow-dark.json"
            },
            {
                "label": "Slatehollow Dark OLED",
                "uiTheme": "vs-dark",
                "path": "themes/slatehollow-dark-oled.json"
            },
            {
                "label": "Slatehollow Light",
                "uiTheme": "vs",
                "path": "themes/slatehollow-light.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ams-sth/vs-code-slatehollow"
    },
